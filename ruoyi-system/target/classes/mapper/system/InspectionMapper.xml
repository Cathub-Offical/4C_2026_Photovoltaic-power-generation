<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.InspectionMapper">

    <resultMap type="com.ruoyi.system.domain.Inspection" id="InspectionResult">
        <result property="id" column="id"/>
        <result property="powerStationName" column="power_station_name"/>
        <result property="deviceName" column="device_name"/>
        <result property="deviceCode" column="device_code"/>
        <result property="inspectionResult" column="inspection_result"/>
        <result property="inspectionType" column="inspection_type"/>
        <result property="downtime" column="downtime"/>
        <result property="inspectionStaff" column="inspection_staff"/>
        <result property="inspectionStartTime" column="inspection_start_time"/>
        <result property="inspectionEndTime" column="inspection_end_time"/>
        <result property="sparePartNameOrNumber" column="spare_part_name_or_number"/>
        <result property="estimatedPowerLoss" column="estimated_power_loss"/>
        <result property="annex" column="annex"/>
        <result property="remark" column="remark"/>
        <result property="createBy" column="create_by"/>
        <result property="createTime" column="create_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="updateTime" column="update_time"/>
    </resultMap>

    <select id="selectInspectionList" parameterType="com.ruoyi.system.domain.Inspection" resultMap="InspectionResult">
        select id, power_station_name, device_name, device_code, inspection_result, inspection_type,
               downtime, inspection_staff, inspection_start_time, inspection_end_time,
               spare_part_name_or_number, estimated_power_loss, annex, remark,
               create_by, create_time, update_by, update_time
        from inspection
        <where>
            <if test="powerStationName != null and powerStationName != ''">
                AND power_station_name like concat('%', #{powerStationName}, '%')
            </if>
            <if test="deviceName != null and deviceName != ''">
                AND device_name like concat('%', #{deviceName}, '%')
            </if>
            <if test="inspectionType != null">
                AND inspection_type = #{inspectionType}
            </if>
            <if test="params.beginTime != null and params.beginTime != ''">
                AND inspection_start_time &gt;= #{params.beginTime}
            </if>
            <if test="params.endTime != null and params.endTime != ''">
                AND inspection_start_time &lt;= concat(#{params.endTime}, ' 23:59:59')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectInspectionById" parameterType="String" resultMap="InspectionResult">
        select id, power_station_name, device_name, device_code, inspection_result, inspection_type,
               downtime, inspection_staff, inspection_start_time, inspection_end_time,
               spare_part_name_or_number, estimated_power_loss, annex, remark,
               create_by, create_time, update_by, update_time
        from inspection where id = #{id}
    </select>

    <insert id="insertInspection" parameterType="com.ruoyi.system.domain.Inspection">
        insert into inspection
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="powerStationName != null">power_station_name,</if>
            <if test="deviceName != null">device_name,</if>
            <if test="deviceCode != null">device_code,</if>
            <if test="inspectionResult != null">inspection_result,</if>
            <if test="inspectionType != null">inspection_type,</if>
            <if test="downtime != null">downtime,</if>
            <if test="inspectionStaff != null">inspection_staff,</if>
            <if test="inspectionStartTime != null">inspection_start_time,</if>
            <if test="inspectionEndTime != null">inspection_end_time,</if>
            <if test="sparePartNameOrNumber != null">spare_part_name_or_number,</if>
            <if test="estimatedPowerLoss != null">estimated_power_loss,</if>
            <if test="annex != null">annex,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="powerStationName != null">#{powerStationName},</if>
            <if test="deviceName != null">#{deviceName},</if>
            <if test="deviceCode != null">#{deviceCode},</if>
            <if test="inspectionResult != null">#{inspectionResult},</if>
            <if test="inspectionType != null">#{inspectionType},</if>
            <if test="downtime != null">#{downtime},</if>
            <if test="inspectionStaff != null">#{inspectionStaff},</if>
            <if test="inspectionStartTime != null">#{inspectionStartTime},</if>
            <if test="inspectionEndTime != null">#{inspectionEndTime},</if>
            <if test="sparePartNameOrNumber != null">#{sparePartNameOrNumber},</if>
            <if test="estimatedPowerLoss != null">#{estimatedPowerLoss},</if>
            <if test="annex != null">#{annex},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateInspection" parameterType="com.ruoyi.system.domain.Inspection">
        update inspection
        <trim prefix="SET" suffixOverrides=",">
            <if test="powerStationName != null">power_station_name = #{powerStationName},</if>
            <if test="deviceName != null">device_name = #{deviceName},</if>
            <if test="deviceCode != null">device_code = #{deviceCode},</if>
            <if test="inspectionResult != null">inspection_result = #{inspectionResult},</if>
            <if test="inspectionType != null">inspection_type = #{inspectionType},</if>
            <if test="downtime != null">downtime = #{downtime},</if>
            <if test="inspectionStaff != null">inspection_staff = #{inspectionStaff},</if>
            <if test="inspectionStartTime != null">inspection_start_time = #{inspectionStartTime},</if>
            <if test="inspectionEndTime != null">inspection_end_time = #{inspectionEndTime},</if>
            <if test="sparePartNameOrNumber != null">spare_part_name_or_number = #{sparePartNameOrNumber},</if>
            <if test="estimatedPowerLoss != null">estimated_power_loss = #{estimatedPowerLoss},</if>
            <if test="annex != null">annex = #{annex},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteInspectionById" parameterType="String">
        delete from inspection where id = #{id}
    </delete>

</mapper>
