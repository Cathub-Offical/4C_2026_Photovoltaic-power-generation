<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.system.mapper.DeviceTypeMapper">

    <resultMap type="com.ruoyi.system.domain.DeviceType" id="DeviceTypeResult">
        <result property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="description" column="description"/>
        <result property="remark" column="remark"/>
        <result property="createTime" column="create_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
    </resultMap>

    <sql id="selectDeviceTypeVo">
        select id, name, description, remark, create_time, create_by, update_time, update_by
        from device_type
    </sql>

    <select id="selectDeviceTypeList" parameterType="com.ruoyi.system.domain.DeviceType" resultMap="DeviceTypeResult">
        <include refid="selectDeviceTypeVo"/>
        <where>
            <if test="name != null and name != ''">
                AND name like concat('%', #{name}, '%')
            </if>
        </where>
        order by create_time desc
    </select>

    <select id="selectDeviceTypeById" parameterType="String" resultMap="DeviceTypeResult">
        <include refid="selectDeviceTypeVo"/>
        where id = #{id}
    </select>

    <insert id="insertDeviceType" parameterType="com.ruoyi.system.domain.DeviceType">
        insert into device_type
        <trim prefix="(" suffix=")" suffixOverrides=",">
            <if test="id != null">id,</if>
            <if test="name != null">name,</if>
            <if test="description != null">description,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null">create_by,</if>
            create_time
        </trim>
        <trim prefix="values (" suffix=")" suffixOverrides=",">
            <if test="id != null">#{id},</if>
            <if test="name != null">#{name},</if>
            <if test="description != null">#{description},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null">#{createBy},</if>
            sysdate()
        </trim>
    </insert>

    <update id="updateDeviceType" parameterType="com.ruoyi.system.domain.DeviceType">
        update device_type
        <trim prefix="SET" suffixOverrides=",">
            <if test="name != null">name = #{name},</if>
            <if test="description != null">description = #{description},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </trim>
        where id = #{id}
    </update>

    <delete id="deleteDeviceTypeById" parameterType="String">
        delete from device_type where id = #{id}
    </delete>

    <delete id="deleteDeviceTypeByIds" parameterType="String">
        delete from device_type where id in
        <foreach item="id" collection="array" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
